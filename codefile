```html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Winter Arc Tracker</title>
<style>
  /* Base & Autumn Theme (Default) */
  :root {
    --bg-color: #241a16; /* Dark espresso brown */
    --accent: #bda56d; /* Muted gold */
    --text-main: #f4ede4;
    --panel-bg: #32251f;
    --grid-bg: #403028;
    --grid-text: #a89f91;
  }
  
  /* Sprint Theme */
  body.sprint-mode {
    --bg-color: #0b1524; /* Deep navy */
    --accent: #fdf5e6; /* Cream */
    --text-main: #ffffff;
    --panel-bg: #152238;
    --grid-bg: #1d2d44;
    --grid-text: #8c9bab;
  }

  body { 
    background-color: #000; 
    display: flex; 
    justify-content: center; 
    align-items: center; 
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; 
    min-height: 100vh; 
    margin: 0; 
    padding: 20px; 
    color: var(--text-main); 
  }

  .widget { 
    background: var(--bg-color); 
    width: 420px; 
    border-radius: 24px; 
    padding: 24px; 
    box-shadow: 0 10px 30px rgba(0,0,0,0.8); 
    transition: all 0.3s ease; 
  }

  .tabs { 
    display: flex; 
    gap: 10px; 
    margin-bottom: 20px; 
    background: rgba(0,0,0,0.3); 
    border-radius: 12px; 
    padding: 6px; 
  }

  .tab { 
    flex: 1; 
    padding: 12px; 
    border: none; 
    background: transparent; 
    color: var(--text-main); 
    cursor: pointer; 
    border-radius: 8px; 
    font-weight: 600; 
    font-size: 0.9em;
    opacity: 0.5; 
    transition: 0.2s;
  }

  .tab.active { 
    background: rgba(255,255,255,0.05); 
    opacity: 1; 
    color: var(--accent); 
  }

  .quote { 
    text-align: center; 
    font-style: italic; 
    font-size: 0.95em; 
    margin-bottom: 20px; 
    padding: 16px; 
    background: rgba(0,0,0,0.2); 
    border-radius: 12px; 
    color: var(--text-main);
  }

  .stats { 
    display: flex; 
    justify-content: space-between; 
    margin-bottom: 20px; 
    background: rgba(0,0,0,0.2); 
    padding: 16px; 
    border-radius: 12px; 
  }

  .stat-box { text-align: center; flex: 1; }
  .stat-label { font-size: 0.65em; text-transform: uppercase; letter-spacing: 1px; opacity: 0.6; }
  .stat-value { font-size: 1.3em; font-weight: 700; color: var(--accent); margin-top: 6px; }

  .grid-container {
    background: rgba(0,0,0,0.2); 
    padding: 16px; 
    border-radius: 12px;
    margin-bottom: 20px;
  }

  .grid { 
    display: grid; 
    grid-template-columns: repeat(7, 1fr); 
    gap: 6px; 
  }

  .day { 
    background: var(--grid-bg); 
    color: var(--grid-text);
    padding: 12px 0; 
    text-align: center; 
    font-size: 0.85em; 
    font-weight: 600;
    border-radius: 6px; 
    cursor: pointer; 
    transition: 0.2s;
  }

  .day:hover { background: var(--accent); color: var(--bg-color); }
  .day.special { grid-column: span 7; background: var(--accent); color: var(--bg-color); font-weight: bold; }

  .checklist { 
    background: rgba(0,0,0,0.2); 
    padding: 20px; 
    border-radius: 12px; 
  }

  .checklist-header { 
    display: flex; 
    justify-content: space-between; 
    margin-bottom: 15px; 
    font-size: 0.8em;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.8;
  }

  .task { 
    display: flex; 
    align-items: center; 
    gap: 12px; 
    padding: 12px; 
    border: 1px solid rgba(255,255,255,0.05); 
    border-radius: 8px; 
    margin-bottom: 10px; 
    transition: 0.2s;
  }

  .task:focus-within { border-color: var(--accent); }
  .task input[type="checkbox"] { accent-color: var(--accent); transform: scale(1.2); cursor: pointer; }
  .task input[type="text"] { background: transparent; border: none; color: var(--text-main); flex: 1; font-size: 0.95em; outline: none; }
  .task button { background: transparent; border: none; color: rgba(255,255,255,0.3); cursor: pointer; font-size: 1em; transition: 0.2s; }
  .task button:hover { color: #ff5555; }

  .add-task { display: flex; gap: 10px; margin-top: 15px; }
  .add-task input { flex: 1; padding: 12px; border-radius: 8px; border: none; background: rgba(0,0,0,0.3); color: white; outline: none; }
  .add-task input:focus { border: 1px solid var(--accent); }
  .add-task button { padding: 12px 20px; border-radius: 8px; border: none; background: var(--accent); color: var(--bg-color); font-weight: bold; cursor: pointer; transition: 0.2s; }
  .add-task button:hover { opacity: 0.8; }
</style>
</head>
<body>

<div class="widget" id="widget">
  <div class="tabs">
    <button class="tab active" onclick="switchTab('autumn')">🍂 Autumn Warm-Up</button>
    <button class="tab" onclick="switchTab('sprint')">❄️ Winter Arc Sprint</button>
  </div>
  
  <div class="quote" id="quoteText">"Autumn is the calm before the glow-up."</div>
  
  <div class="stats">
    <div class="stat-box"><div class="stat-label">Day Index</div><div class="stat-value" id="dayIndex">#1 / 31</div></div>
    <div class="stat-box"><div class="stat-label">Perfect Days</div><div class="stat-value">0 🔥</div></div>
    <div class="stat-box"><div class="stat-label">Arc Level</div><div class="stat-value">0%</div></div>
  </div>

  <div class="grid-container">
    <div class="grid" id="calendarGrid"></div>
  </div>

  <div class="checklist">
    <div class="checklist-header">
      <strong>Focus Checklist</strong>
    </div>
    <div id="taskList">
      <div class="task">
        <input type="checkbox">
        <input type="text" value="Warm tea & plan the day">
        <button onclick="this.parentElement.remove()">✕</button>
      </div>
      <div class="task">
        <input type="checkbox">
        <input type="text" value="30 min outdoor crisp air walk">
        <button onclick="this.parentElement.remove()">✕</button>
      </div>
    </div>
    <div class="add-task">
      <input type="text" id="newTaskInput" placeholder="Add new discipline..." onkeypress="handleEnter(event)">
      <button onclick="addTask()">Add</button>
    </div>
  </div>
</div>

<script>
  const config = {
    autumn: { quote: '"Autumn is the calm before the glow-up."', days: 31, special: "Winter Arc Eve: Final Prep" },
    sprint: { quote: '"While they rest, you build."', days: 65, special: null }
  };

  function renderGrid(type) {
    const grid = document.getElementById('calendarGrid');
    grid.innerHTML = '';
    const days = config[type].days;
    
    for(let i = 1; i <= days; i++) {
      if (i === days && config[type].special) {
        grid.innerHTML += `<div class="day special">Day ${i}: ${config[type].special}</div>`;
      } else {
        grid.innerHTML += `<div class="day">${i}</div>`;
      }
    }
    document.getElementById('dayIndex').innerText = `#1 / ${days}`;
  }

  function switchTab(type) {
    document.body.className = type === 'sprint' ? 'sprint-mode' : '';
    document.querySelectorAll('.tab').forEach((t, i) => {
      t.classList.toggle('active', (type === 'autumn' && i === 0) || (type === 'sprint' && i === 1));
    });
    document.getElementById('quoteText').innerText = config[type].quote;
    renderGrid(type);
  }

  function addTask() {
    const input = document.getElementById('newTaskInput');
    const val = input.value.trim();
    if (!val) return;
    
    const taskHTML = `
      <div class="task">
        <input type="checkbox">
        <input type="text" value="${val}">
        <button onclick="this.parentElement.remove()">✕</button>
      </div>`;
      
    document.getElementById('taskList').insertAdjacentHTML('beforeend', taskHTML);
    input.value = '';
  }

  function handleEnter(event) {
    if (event.key === 'Enter') {
      addTask();
    }
  }

  // Initialize Default Tab
  renderGrid('autumn');
</script>
</body>
</html>

